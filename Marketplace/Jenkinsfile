
pipeline {

    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    parameters {
        booleanParam(
            name: 'RUN_SECURITY_SCAN',
            defaultValue: false,
            description: 'Activer le scan OWASP'
        )
    }

    environment {
        POSTGRES_HOST = 'marketplace-postgres'
    }

    stages {

        stage('1 - Checkout GitHub') {
            steps {
                checkout scm
                sh 'pwd'
                sh 'ls -la'
                sh 'ls -la backend'
            }
        }

        stage('2 - Verification structure') {
            steps {
                script {
                    def services = [
                        'user-service',
                        'catalog-service',
                        'cart-service',
                        'order-service',
                        'notification-service',
                        'api-gateway'
                    ]

                    for (service in services) {
                        dir("backend/${service}") {
                            sh 'test -f pom.xml'
                            sh 'test -f mvnw'
                            echo "Structure OK : ${service}"
                        }
                    }
                }
            }
        }

        stage('3 - Verification Java') {
            steps {
                sh 'java -version'
                sh 'git --version'
            }
        }

        stage('4 - Compilation Java') {
            steps {
                script {
                    def services = [
                        'user-service',
                        'catalog-service',
                        'cart-service',
                        'order-service',
                        'notification-service',
                        'api-gateway'
                    ]

                    for (service in services) {
                        dir("backend/${service}") {
                            echo "Compilation : ${service}"
                            sh 'sh ./mvnw -B -DskipTests compile'
                        }
                    }
                }
            }
        }

        stage('5 - Analyse qualite Checkstyle') {
            steps {
                script {
                    def services = [
                        'user-service',
                        'catalog-service',
                        'cart-service',
                        'order-service',
                        'notification-service',
                        'api-gateway'
                    ]

                    for (service in services) {
                        dir("backend/${service}") {
                            echo "Checkstyle : ${service}"

                            sh '''
                                sh ./mvnw -B \
                                org.apache.maven.plugins:maven-checkstyle-plugin:3.6.0:checkstyle
                            '''
                        }
                    }
                }
            }
        }

        stage('6 - Verification dependances') {
            steps {
                script {
                    def services = [
                        'user-service',
                        'catalog-service',
                        'cart-service',
                        'order-service',
                        'notification-service',
                        'api-gateway'
                    ]

                    for (service in services) {
                        dir("backend/${service}") {
                            echo "Dependances : ${service}"
                            sh 'sh ./mvnw -B dependency:tree'
                        }
                    }
                }
            }
        }

        stage('7 - Analyse securite OWASP') {
            when {
                expression {
                    return params.RUN_SECURITY_SCAN
                }
            }

            steps {
                withCredentials([
                    string(
                        credentialsId: 'nvd-api-key',
                        variable: 'NVD_API_KEY'
                    )
                ]) {
                    script {
                        def services = [
                            'user-service',
                            'catalog-service',
                            'cart-service',
                            'order-service',
                            'notification-service',
                            'api-gateway'
                        ]

                        for (service in services) {
                            dir("backend/${service}") {
                                echo "OWASP : ${service}"

                                sh '''
                                    sh ./mvnw -B \
                                    org.owasp:dependency-check-maven:13.0.0:check \
                                    -DnvdApiKeyEnvironmentVariable=NVD_API_KEY \
                                    -DdataDirectory=/var/jenkins_home/owasp-data \
                                    -DfailBuildOnCVSS=7 \
                                    -Dformat=HTML
                                '''
                            }
                        }
                    }
                }
            }
        }

        stage('8 - Tests unitaires') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'marketplace-db-password',
                        variable: 'DB_PASSWORD'
                    )
                ]) {
                    script {
                        def databases = [
                            'user-service': 'user_db',
                            'catalog-service': 'catalog_db',
                            'cart-service': 'cart_db',
                            'order-service': 'order_db'
                        ]

                        databases.each { service, database ->
                            dir("backend/${service}") {
                                echo "Tests : ${service}"

                                withEnv([
                                    "SPRING_DATASOURCE_URL=jdbc:postgresql://marketplace-postgres:5432/${database}"
                                ]) {
                                    sh 'sh ./mvnw -B test'
                                }
                            }
                        }

                        for (service in [
                            'notification-service',
                            'api-gateway'
                        ]) {
                            dir("backend/${service}") {
                                echo "Tests : ${service}"
                                sh 'sh ./mvnw -B test'
                            }
                        }
                    }
                }
            }
        }

        stage('9 - Tests integration PostgreSQL') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'marketplace-db-password',
                        variable: 'DB_PASSWORD'
                    )
                ]) {
                    dir('backend/user-service') {

                        withEnv([
                            'SPRING_DATASOURCE_URL=jdbc:postgresql://marketplace-postgres:5432/user_db'
                        ]) {
                            sh '''
                                sh ./mvnw -B \
                                org.apache.maven.plugins:maven-failsafe-plugin:3.6.0:integration-test \
                                org.apache.maven.plugins:maven-failsafe-plugin:3.6.0:verify
                            '''
                        }
                    }
                }
            }
        }

        stage('10 - Packaging JAR') {
            steps {
                script {
                    def services = [
                        'user-service',
                        'catalog-service',
                        'cart-service',
                        'order-service',
                        'notification-service',
                        'api-gateway'
                    ]

                    for (service in services) {
                        dir("backend/${service}") {
                            echo "Packaging : ${service}"
                            sh 'sh ./mvnw -B -DskipTests package'
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            junit(
                testResults: 'backend/**/target/surefire-reports/TEST-*.xml,backend/**/target/failsafe-reports/TEST-*.xml',
                allowEmptyResults: true
            )

            archiveArtifacts(
                artifacts: 'backend/**/target/site/checkstyle.html,backend/**/target/dependency-check-report.html',
                allowEmptyArchive: true
            )
        }

        success {
            echo 'SUCCESS : Pipeline CI terminee.'
        }

        failure {
            echo 'FAILURE : verifier Console Output.'
        }
    }
}
